{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "runtime": {
      "type": "string",
      "const": "llama.cpp"
    },
    "release": {
      "type": "string",
      "minLength": 1
    },
    "build": {
      "type": "string",
      "pattern": "^b\\d+$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "platform": {
      "type": "string",
      "minLength": 1
    },
    "archiveDir": {
      "type": "string",
      "minLength": 1
    },
    "installDir": {
      "type": "string",
      "minLength": 1
    },
    "archives": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "file": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "sha256",
          "size",
          "file"
        ],
        "additionalProperties": false
      }
    },
    "binaries": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "sha256",
          "size"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "runtime",
    "release",
    "build",
    "commit",
    "platform",
    "archiveDir",
    "installDir",
    "archives",
    "binaries"
  ],
  "additionalProperties": false,
  "$id": "https://kairos-personality.local/schema/runtime-lock.json",
  "title": "Kairos Personality Runtime Lock"
}
