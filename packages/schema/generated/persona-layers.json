{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "identity": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "type": "string",
          "minLength": 2
        },
        "tone": {
          "type": "string",
          "minLength": 1
        },
        "self_intro": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "name",
        "language",
        "tone",
        "self_intro"
      ],
      "additionalProperties": false
    },
    "style": {
      "type": "object",
      "properties": {
        "slang": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "humor": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "sarcasm": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "drama": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "profanity": {
          "type": "string",
          "enum": [
            "livre",
            "moderado",
            "nenhum"
          ]
        },
        "task_verbosity": {
          "type": "string",
          "enum": [
            "curta",
            "media",
            "longa"
          ]
        },
        "verbosity": {
          "type": "string",
          "enum": [
            "curta",
            "media",
            "longa"
          ]
        },
        "formality": {
          "type": "string",
          "enum": [
            "baixa",
            "media",
            "alta"
          ]
        },
        "proactivity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "slang",
        "humor",
        "sarcasm",
        "drama",
        "profanity",
        "task_verbosity",
        "verbosity",
        "formality",
        "proactivity"
      ],
      "additionalProperties": false
    },
    "lexicon": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "term": {
            "type": "string",
            "minLength": 1
          },
          "meaning": {
            "type": "string",
            "minLength": 1
          },
          "register": {
            "type": "string",
            "minLength": 1
          },
          "example": {
            "type": "string",
            "minLength": 1
          },
          "provenance": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "term",
          "meaning",
          "register",
          "example",
          "provenance"
        ],
        "additionalProperties": false
      }
    },
    "goals": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "priority": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "id",
          "description",
          "priority"
        ],
        "additionalProperties": false
      }
    },
    "traits_base": {
      "type": "object",
      "properties": {
        "openness": {
          "type": "number"
        },
        "conscientiousness": {
          "type": "number"
        },
        "extraversion": {
          "type": "number"
        },
        "agreeableness": {
          "type": "number"
        },
        "neuroticism": {
          "type": "number"
        }
      },
      "required": [
        "openness",
        "conscientiousness",
        "extraversion",
        "agreeableness",
        "neuroticism"
      ],
      "additionalProperties": false
    },
    "affect_gains": {
      "type": "object",
      "properties": {
        "valence_gain": {
          "type": "number"
        },
        "arousal_gain": {
          "type": "number"
        },
        "dominance_gain": {
          "type": "number"
        },
        "decay_per_min": {
          "type": "number",
          "minimum": 0
        },
        "mood_drift": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "valence_gain",
        "arousal_gain",
        "dominance_gain",
        "decay_per_min",
        "mood_drift"
      ],
      "additionalProperties": false
    },
    "floors": {
      "type": "object",
      "properties": {
        "facts": {
          "type": "string",
          "const": "P1"
        },
        "approval": {
          "type": "string",
          "const": "P2"
        },
        "pii_third_party": {
          "type": "string",
          "const": "never"
        },
        "identity_disclosure": {
          "type": "string",
          "const": "on_request"
        },
        "influence_disclosure": {
          "type": "string",
          "const": "on_request"
        },
        "explicit_content": {
          "type": "string",
          "const": "allow"
        },
        "crisis": {
          "type": "string",
          "const": "care"
        }
      },
      "required": [
        "facts",
        "approval",
        "pii_third_party",
        "identity_disclosure",
        "influence_disclosure",
        "explicit_content",
        "crisis"
      ],
      "additionalProperties": false
    },
    "failure_reaction": {
      "type": "object",
      "properties": {
        "partial": {
          "type": "string",
          "minLength": 1
        },
        "failed": {
          "type": "string",
          "minLength": 1
        },
        "synthetic": {
          "type": "string",
          "minLength": 1
        },
        "unknown": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "partial",
        "failed",
        "synthetic",
        "unknown"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "identity",
    "style",
    "lexicon",
    "goals",
    "traits_base",
    "affect_gains",
    "floors",
    "failure_reaction"
  ],
  "additionalProperties": false,
  "$id": "https://kairos-personality.local/schema/persona-layers.json",
  "title": "Kairos Personality Persona Layers"
}
