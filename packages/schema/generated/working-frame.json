{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "trace": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "root": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "kind": {
          "type": "string",
          "const": "interactive"
        },
        "trace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "startedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        }
      },
      "required": [
        "id",
        "kind",
        "trace",
        "startedAt"
      ],
      "additionalProperties": false
    },
    "tasks": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "kind": {
            "type": "string",
            "const": "task"
          },
          "trace": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "state": {
            "type": "string",
            "enum": [
              "pending",
              "running",
              "awaiting-approval",
              "executed",
              "failed",
              "cancelled",
              "unknown"
            ]
          },
          "flow": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "origin": {
            "type": "string",
            "enum": [
              "user",
              "persona"
            ]
          },
          "startedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "pending": {
            "type": "boolean"
          },
          "lastReport": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          }
        },
        "required": [
          "id",
          "kind",
          "trace",
          "state",
          "flow",
          "origin",
          "startedAt",
          "pending"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "trace",
    "root",
    "tasks"
  ],
  "additionalProperties": false,
  "$id": "https://kairos-personality.local/schema/working-frame.json",
  "title": "Kairos Personality Working Frame"
}
