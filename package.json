{
  "name": "kairos-personality",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "scripts"
  ],
  "scripts": {
    "start": "bun apps/personality-core/src/main.ts",
    "typecheck": "tsc --noEmit",
    "gen:schema": "bun packages/schema/scripts/generate-schema.ts",
    "test": "bun test",
    "verify:runtime-pins": "bun scripts/verify-runtime-pins.ts",
    "check:delegations": "bun scripts/check-delegations.ts",
    "check": "bun run typecheck && bun test"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  }
}
